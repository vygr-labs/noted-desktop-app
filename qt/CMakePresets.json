{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "_base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": { "CMAKE_PREFIX_PATH": "$env{CMAKE_PREFIX_PATH}" }
    },
    {
      "name": "release",
      "displayName": "Release (Ninja)",
      "inherits": "_base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "NOTED_BUILD_TESTS": "ON" }
    },
    {
      "name": "debug",
      "displayName": "Debug (Ninja)",
      "inherits": "_base",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "NOTED_BUILD_TESTS": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "release-app", "configurePreset": "release", "targets": ["noted"] },
    { "name": "debug", "configurePreset": "debug" }
  ]
}
